PORT=3002
HOST=127.0.0.1
# Restricted PostgreSQL runtime role; migrate/import explicitly before starting.
HR_PG_URL=postgresql://hr_runtime:replace-with-runtime-password@127.0.0.1:55432/hr_foundation
# Optional compatibility default for older clients; new clients send workspace at login.
HR_DEFAULT_WORKSPACE=
# Encrypts platform-owner authenticator secrets and invitation retry tokens.
# Use 32 random bytes as 64 hex characters. Keep stable and back up privately.
HR_OWNER_ENCRYPTION_KEY=
# Set false to bypass backend reference-data caching.
HR_READ_CACHE=true
HR_ALLOWED_ORIGINS=http://localhost:3003
