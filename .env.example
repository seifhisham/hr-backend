PORT=3002
HOST=127.0.0.1
HR_DATABASE_PATH=data/hr.sqlite
# Set false to bypass backend reference-data caching.
HR_READ_CACHE=true
HR_ALLOWED_ORIGINS=http://localhost:3003
# Used only to create the first administrator in an empty database.
HR_ADMIN_EMAIL=admin@company.local
HR_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-8-characters
