# Separate migration/test administration and restricted application runtime credentials.
# Export migration/test variables explicitly for PostgreSQL scripts. The owner bootstrap also reads backend .env.
HR_POSTGRES_PASSWORD=replace-with-a-unique-development-password
HR_PG_MIGRATION_URL=postgresql://hr_migration:replace-with-a-unique-development-password@127.0.0.1:55432/hr_foundation
HR_PG_TEST_ADMIN_URL=postgresql://hr_migration:replace-with-a-unique-development-password@127.0.0.1:55432/hr_foundation
HR_PG_RUNTIME_PASSWORD=replace-with-a-different-password-at-least-24-characters
HR_PG_URL=postgresql://hr_runtime:replace-with-a-different-password-at-least-24-characters@127.0.0.1:55432/hr_foundation
# Separate 32-byte owner-secret encryption key, encoded as 64 hex characters.
# Generate privately with Node crypto.randomBytes(32).toString('hex'); back up securely.
HR_OWNER_ENCRYPTION_KEY=
